# BlockWallet Extension Environment Variables
# Copy this file to .env and add your actual API keys

# Alchemy API Key for real-time blockchain monitoring
# Get your API key from: https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Infura API Key (fallback provider)
# Get your API key from: https://app.infura.io/
INFURA_API_KEY=your_infura_api_key_here
