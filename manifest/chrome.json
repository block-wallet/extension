{
    "background": {
        "service_worker": "sw-wrapper.js"
    },
    "content_scripts": [
        {
            "js": [
                "content.js"
            ],
            "matches": [
                "https://*/*"
            ],
            "exclude_matches": [
                "https://block-wallet.github.io/eth-ledger-bridge-keyring/*",
                "https://connect.trezor.io/*"
            ],
            "run_at": "document_start",
            "all_frames": true
        },
        {
            "js": [
                "vendor/trezor/trezor-content.js"
            ],
            "matches": [
                "https://connect.trezor.io/*/popup.html"
            ]
        }
    ],
    "permissions": [
        "storage"
    ],
    "optional_permissions": [
        "offscreen"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "offscreen.html",
                "hardware-wallet-bridge.html",
                "offscreen.js",
                "hardware-wallet-bridge.js",
                "background.js",
                "sw-wrapper.js"
            ],
            "matches": [
                "https://*/*"
            ]
        }
    ]
}