{
    "background": {
        "service_worker": "sw-wrapper.js"
    },
    "content_scripts": [
        {
            "js": [
                "content.js"
            ],
            "matches": [
                "https://*/*"
            ],
            "exclude_matches": [
                "https://block-wallet.github.io/eth-ledger-bridge-keyring/*",
                "https://connect.trezor.io/*"
            ],
            "run_at": "document_start",
            "all_frames": true,
            "world": "ISOLATED"
        },
        {
            "js": [
                "blankProvider.js"
            ],
            "matches": [
                "https://*/*"
            ],
            "exclude_matches": [
                "https://block-wallet.github.io/eth-ledger-bridge-keyring/*",
                "https://connect.trezor.io/*"
            ],
            "run_at": "document_start",
            "all_frames": true,
            "world": "MAIN"
        },
        {
            "js": [
                "vendor/trezor/trezor-content.js"
            ],
            "matches": [
                "https://connect.trezor.io/*/popup.html"
            ],
            "world": "ISOLATED"
        }
    ],
    "permissions": [
        "storage",
        "alarms",
        "scripting",
        "tabs",
        "offscreen"
    ],
    "host_permissions": [
        "http://localhost:8545/*",
        "http://127.0.0.1:8545/*",
        "https://www.4byte.directory/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "blankProvider.js",
                "offscreen.html",
                "hardware-wallet-bridge.html",
                "offscreen.js",
                "hardware-wallet-bridge.js",
                "background.js",
                "sw-wrapper.js"
            ],
            "matches": [
                "https://*/*"
            ],
            "use_dynamic_url": false
        }
    ]
}
