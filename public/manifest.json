{
    "author": "BlockWallet",
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "js": [
                "content.js"
            ],
            "matches": [
                "https://*/*"
            ],
            "exclude_matches": [
                "https://block-wallet.github.io/eth-ledger-bridge-keyring/*",
                "https://connect.trezor.io/*"
            ],
            "run_at": "document_start",
            "all_frames": true,
            "world": "ISOLATED"
        },
        {
            "js": [
                "vendor/trezor/trezor-content.js"
            ],
            "matches": [
                "https://connect.trezor.io/*/popup.html"
            ],
            "world": "ISOLATED"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "BlockWallet",
        "default_icon": {
            "16": "icons/icon-16.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "description": "All eyes on your dreams with BlockWallet - your self-custodial Web3 wallet that handles the rest.",
    "homepage_url": "https://www.blockwallet.io/",
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "content_security_policy": {
        "extension_pages": "default-src 'self'; connect-src 'self' https://mainnet-node.blockwallet.io https://mainnet.blockwallet.io https://raw.githubusercontent.com https://chain-fee.blockwallet.io https://api.onramper.com https://li.quest https://rpc.ankr.com https://api.etherscan.io https://api.coingecko.com; img-src 'self' data:; script-src 'self'; object-src 'none'; worker-src 'self'"
    },
    "manifest_version": 3,
    "name": "BlockWallet",
    "permissions": [
        "storage",
        "unlimitedStorage",
        "activeTab",
        "tabs",
        "scripting",
        "notifications",
        "offscreen"
    ],
    "optional_permissions": [],
    "host_permissions": [
        "https://mainnet-node.blockwallet.io/*",
        "https://mainnet.blockwallet.io/*",
        "https://raw.githubusercontent.com/*",
        "https://chain-fee.blockwallet.io/*",
        "https://api.onramper.com/*",
        "https://li.quest/*",
        "https://rpc.ankr.com/*",
        "https://api.etherscan.io/*",
        "https://api.coingecko.com/*"
    ],
    "optional_host_permissions": [],
    "short_name": "BlockWallet",
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+O"
            },
            "description": "Start the extension"
        }
    },
    "version": "2.0.3",
    "version_name": "2.0.3",
    "web_accessible_resources": [
        {
            "resources": [
                "blankProvider.js",
                "keep-alive",
                "background.js",
                "hardware-wallet-bridge.js",
                "hardware-wallet-bridge-navigation.js",
                "offscreen-bridge.js",
                "offscreen.html",
                "offscreen.js",
                "offscreen-logger.js"
            ],
            "matches": [
                "https://*/*"
            ],
            "use_dynamic_url": false
        },
        {
            "resources": [
                "images/*"
            ],
            "matches": [
                "https://*/*"
            ],
            "use_dynamic_url": false
        }
    ],
    "externally_connectable": {
        "matches": [
            "https://*/*"
        ],
        "accepts_tls_channel_id": false
    },
    "minimum_chrome_version": "88",
    "side_panel": {
        "default_path": "popup.html"
    },
    "cross_origin_embedder_policy": {
        "value": "require-corp"
    },
    "cross_origin_opener_policy": {
        "value": "same-origin"
    }
}
